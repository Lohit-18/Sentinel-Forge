# SentinelForge local configuration.
#
# `bash scripts/setup.sh` copies this file to .env and replaces every
# "change-me" value with a random password. Never commit .env.
# Only SF_* variables are read by SentinelForge and its scripts.

# Where PostgreSQL runs:
#   native  PostgreSQL installed in WSL/Linux (default; free, no Docker needed)
#   docker  the container in compose.yaml (optional; see docs/installation.md)
SF_DB_MODE=native

SF_DB_HOST=127.0.0.1
SF_DB_PORT=5432
SF_DB_NAME=sentinelforge
SF_DB_SCHEMA=sentinelforge

# Admin role: owns the database schema and runs setup/migrations only.
SF_DB_ADMIN_USER=sentinelforge_admin
SF_DB_ADMIN_PASSWORD=change-me

# Application role: used by the app at runtime. Least privilege:
# it can read, insert and update data, but cannot create, drop or delete.
SF_DB_APP_USER=sentinelforge_app
SF_DB_APP_PASSWORD=change-me

SF_LOG_LEVEL=INFO
